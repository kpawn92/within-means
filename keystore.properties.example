# Plantilla de la config de firma de release.
#
# 1. Genera tu keystore (UNA sola vez; guárdalo a buen recaudo y NO lo pierdas
#    ni lo subas al repo — sin él no puedes publicar actualizaciones):
#
#    keytool -genkeypair -v \
#      -keystore within-means-release.jks \
#      -alias within-means \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Copia este archivo a `keystore.properties` (gitignorado) y rellena los
#    valores reales. La ruta de storeFile es relativa a la raíz del proyecto.
#
#    cp keystore.properties.example keystore.properties
#
# Sin keystore.properties el build de release compila pero queda SIN FIRMAR
# (android-release-unsigned.apk) — útil para CI/desarrollo.

storeFile=within-means-release.jks
storePassword=CHANGEME
keyAlias=within-means
keyPassword=CHANGEME
